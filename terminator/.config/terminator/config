# ~/.config/terminator/config — high contrast (Catppuccin Mocha palette)
[global_config]
  borderless = True
  suppress_multiple_term_dialog = True
  title_hide_sizetext = True
  inactive_color_offset = 1.0
[keybindings]
[profiles]
  [[default]]
    use_system_font = False
    font = JetBrainsMono Nerd Font 11
    # Near-black background and near-white text for maximum contrast
    background_color = "#0b0b12"
    foreground_color = "#f4f6ff"
    cursor_color = "#f5c2e7"
    cursor_shape = ibeam
    palette = "#45475a:#ff7aa2:#a6e3a1:#f9e2af:#89b4fa:#f5c2e7:#94e2d5:#dce0f0:#6c7086:#ff9ab8:#c3f5be:#fff0c4:#a9c8ff:#ffd6f1:#b6f2e6:#ffffff"
    bold_is_bright = True
    show_titlebar = False
    scrollbar_position = hidden
    scrollback_lines = 10000
    copy_on_selection = True
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
[plugins]
