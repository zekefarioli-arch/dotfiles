#!/usr/bin/env bash
# Battery for polybar: level icon in 10% steps (Catppuccin red / peach / green),
# percentage and time left in short form, e.g. "18%/1h1m".
#   on battery            icon 18%/1h1m   (time to empty)
#   plugged in, charging  bolt+icon 35%/1h20m   (time to full)
#   plugged in, idle      plug 97%   (full, or held by the ThinkPad charge
#                                     threshold: "Not charging")
# Polybar's internal battery module treats "Not charging" as discharging, so it
# would show a meaningless time while plugged in.
BAT="${BAT:-/sys/class/power_supply/BAT0}"
AC="${AC:-/sys/class/power_supply/AC}"
RED="#f38ba8"; PEACH="#fab387"; GREEN="#a6e3a1"
ICONS=(󰂎 󰁺 󰁻 󰁼 󰁽 󰁾 󰁿 󰂀 󰂁 󰂂 󰁹)

read_or() { cat "$1" 2>/dev/null || echo "$2"; }

pct=$(read_or "$BAT/capacity" 0)
status=$(read_or "$BAT/status" Unknown)
online=$(read_or "$AC/online" 0)
# Energy (µWh) and power (µW); some batteries report charge (µAh) and current (µA)
now=$(read_or "$BAT/energy_now" "$(read_or "$BAT/charge_now" 0)")
full=$(read_or "$BAT/energy_full" "$(read_or "$BAT/charge_full" 0)")
rate=$(read_or "$BAT/power_now" "$(read_or "$BAT/current_now" 0)")

level=$(( pct >= 100 ? 10 : pct / 10 ))
if   (( pct < 30 )); then color=$RED
elif (( pct < 40 )); then color=$PEACH
else                      color=$GREEN
fi
icon="%{F$color}${ICONS[$level]}%{F-}"

short_time() {  # minutes -> "2h5m" or "45m" (nothing if unknown)
  local minutes=$1
  (( minutes <= 0 )) && return
  if (( minutes >= 60 )); then printf '%dh%dm' $((minutes / 60)) $((minutes % 60))
  else printf '%dm' "$minutes"
  fi
}

if [[ $status == Charging ]]; then
  t=$(( rate > 0 ? (full - now) * 60 / rate : 0 ))
  t=$(short_time "$t")
  echo "%{F$GREEN}󱐋%{F-}$icon ${pct}%${t:+/$t}"
elif [[ $online == 1 ]]; then
  echo "%{F$GREEN}󰚥%{F-} ${pct}%"
else
  t=$(( rate > 0 ? now * 60 / rate : 0 ))
  t=$(short_time "$t")
  echo "$icon ${pct}%${t:+/$t}"
fi
