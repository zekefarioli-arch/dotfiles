#!/usr/bin/env bash
# Battery for polybar: level icon in 10% steps (Catppuccin red / peach / green),
# percentage and time left in short form, e.g. "18%|1h1m".
#   on battery            icon 18%|unplugged 1h1m       (time to empty)
#   plugged in, charging  icon 35%|plug 1h20m           (time to full)
#   plugged in, idle      plug 97%   (full, or held by the ThinkPad charge
#                                     threshold: "Not charging")
# Polybar's internal battery module treats "Not charging" as discharging, so it
# would show a meaningless time while plugged in.
# The power reading jumps with every burst of load, so the time uses an
# exponential moving average of it with a ~2 minute time constant, kept in
# $XDG_RUNTIME_DIR between runs (polybar runs this every 5 s). The average
# restarts when switching between charging and discharging, or after a gap
# longer than a minute (e.g. a suspend).
BAT="${BAT:-/sys/class/power_supply/BAT0}"
STATE="${STATE:-${XDG_RUNTIME_DIR:-/tmp}/battery-status.state}"
TAU=120   # seconds
AC="${AC:-/sys/class/power_supply/AC}"
# Desktop without a battery: print nothing, so polybar hides the module (shared dotfiles).
[ -d "$BAT" ] || exit 0
RED="#f38ba8"; PEACH="#fab387"; GREEN="#a6e3a1"; GREY="#6c7086"
SEP="%{F$GREY}|%{F-}"   # same grey separator as between the bar modules
ICONS=(󰂎 󰁺 󰁻 󰁼 󰁽 󰁾 󰁿 󰂀 󰂁 󰂂 󰁹)

read_or() { cat "$1" 2>/dev/null || echo "$2"; }

pct=$(read_or "$BAT/capacity" 0)
status=$(read_or "$BAT/status" Unknown)
online=$(read_or "$AC/online" 0)
# Energy (µWh) and power (µW); some batteries report charge (µAh) and current (µA)
now=$(read_or "$BAT/energy_now" "$(read_or "$BAT/charge_now" 0)")
full=$(read_or "$BAT/energy_full" "$(read_or "$BAT/charge_full" 0)")
rate=$(read_or "$BAT/power_now" "$(read_or "$BAT/current_now" 0)")

if   [[ $status == Charging ]]; then mode=charging
elif [[ $online == 1 ]];        then mode=idle
else                                 mode=discharging
fi
now_s="${NOW:-$(date +%s)}"
avg=$rate
if [[ -r $STATE ]] && read -r pmode pavg pts < "$STATE" && (( rate > 0 )) &&
   [[ $pmode == "$mode" ]] && (( pavg > 0 && now_s > pts && now_s - pts <= 60 )); then
  avg=$(awk -v a="$pavg" -v r="$rate" -v dt=$(( now_s - pts )) -v tau=$TAU \
        'BEGIN { printf "%d", a + dt / (tau + dt) * (r - a) }')
fi
echo "$mode $avg $now_s" > "$STATE"
rate=$avg

level=$(( pct >= 100 ? 10 : pct / 10 ))
if   (( pct < 30 )); then color=$RED
elif (( pct < 40 )); then color=$PEACH
else                      color=$GREEN
fi
icon="%{F$color}${ICONS[$level]}%{F-}"

short_time() {  # minutes -> "2h5m" or "45m" (nothing if unknown)
  local minutes=$1
  (( minutes <= 0 )) && return
  if (( minutes >= 60 )); then printf '%dh%dm' $((minutes / 60)) $((minutes % 60))
  else printf '%dm' "$minutes"
  fi
}

if [[ $status == Charging ]]; then
  t=$(( rate > 0 ? (full - now) * 60 / rate : 0 ))
  t=$(short_time "$t")
  echo "$icon ${pct}%${t:+$SEP%{F$GREEN\}󰚥%{F-\} $t}"
elif [[ $online == 1 ]]; then
  echo "%{F$GREEN}󰚥%{F-} ${pct}%"
else
  t=$(( rate > 0 ? now * 60 / rate : 0 ))
  t=$(short_time "$t")
  echo "$icon ${pct}%${t:+$SEP%{F$RED\}󰚦%{F-\} $t}"
fi
