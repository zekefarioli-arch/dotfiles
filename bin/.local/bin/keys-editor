#!/usr/bin/env python3
"""Shortcut editor for the xmonad actions (rofi UI and a small CLI).

Reads the action catalog that xmonad exports at startup
(~/.cache/xmonad/actions.tsv) and edits ~/.xmonad/keys.conf, then restarts
xmonad so the change applies at once (no recompile).

  keys-editor                         open the rofi editor (Super+Shift+F1)
  keys-editor list                    print every action and its shortcuts
  keys-editor set ACTION SLOT KEY     set shortcut SLOT (1 or 2) to KEY (EZConfig)
  keys-editor remove ACTION SLOT      remove shortcut SLOT
  keys-editor reset ACTION            go back to the default shortcuts
  keys-editor free [N]                print N free shortcut suggestions
  keys-editor edit ACTION             open the rofi editor on one action
  keys-editor new DESC COMMAND [CAT]  add a custom action that runs COMMAND
  keys-editor delete ACTION           delete a custom action
"""
import os
import re
import subprocess
import sys

sys.path.insert(0, os.path.expanduser("~/.local/lib/xmonad-keys"))
import xkeys  # noqa: E402

ACTIONS_FILE = os.path.expanduser("~/.cache/xmonad/actions.tsv")
KEYS_FILE = os.path.expanduser("~/.xmonad/keys.conf")
CUSTOM_FILE = os.path.expanduser("~/.xmonad/actions.conf")
MAX_SLOTS = 2
NAME_WIDTH = 24   # same column as the generated keys.conf


class Action:
    def __init__(self, category, name, desc, current, default, kind="", command=""):
        self.category, self.name, self.desc = category, name, desc
        self.keys = current.split()
        self.default = default.split()
        self.custom = kind == "custom"
        self.command = command


def load_overrides():
    """Shortcuts written in keys.conf: {action name: [shortcuts]}."""
    overrides = {}
    if os.path.exists(KEYS_FILE):
        with open(KEYS_FILE, encoding="utf-8") as f:
            for line in f:
                words = line.split()
                if words and not words[0].startswith("#"):
                    overrides[words[0]] = words[1:]
    return overrides


def load_actions():
    """The catalog (names, descriptions, defaults) comes from actions.tsv; the
    current shortcuts come from keys.conf, which is the source of truth (the
    current column of actions.tsv lags until xmonad has restarted)."""
    overrides = load_overrides()
    actions = []
    with open(ACTIONS_FILE, encoding="utf-8") as f:
        for line in f:
            parts = line.rstrip("\n").split("\t")
            if len(parts) >= 5:
                a = Action(*parts[:7])
                a.keys = list(overrides.get(a.name, a.default))
                actions.append(a)
    return actions


def find(actions, name):
    for a in actions:
        if a.name == name:
            return a
    sys.exit(f"keys-editor: unknown action '{name}'")


def owner(actions, ez, skip=None):
    """Action that already uses shortcut ez (ignoring action skip)."""
    target = xkeys.canonical(ez)
    for a in actions:
        if a is not skip and any(xkeys.canonical(k) == target for k in a.keys):
            return a
    return None


def free_shortcuts(actions, limit=12):
    """Unused Super combinations, simplest first."""
    used = {xkeys.canonical(k) for a in actions for k in a.keys}
    keys = list("abcdfgiouyxzs") + [str(d) for d in range(10)] + list(";'#[]-=")
    out = []
    for mods in ("M", "M-S", "M-C", "M-M1", "M-C-S"):
        for k in keys:
            ez = xkeys.canonical(f"{mods}-{k}")
            if ez not in used and ez not in out:
                out.append(ez)
                if len(out) >= limit:
                    return out
    return out


# ---------------------------------------------------------------------------
# keys.conf
# ---------------------------------------------------------------------------

def save(actions, changed):
    """Rewrite the lines of the changed actions in keys.conf, keeping the
    comments and layout; actions missing from the file are added under their
    category header. Writes atomically through the stow symlink."""
    path = os.path.realpath(KEYS_FILE)
    with open(path, encoding="utf-8") as f:
        lines = f.read().split("\n")
    for a in changed:
        new = f"{a.name:<{NAME_WIDTH}}  {'  '.join(a.keys)}".rstrip()
        pattern = re.compile(rf"^{re.escape(a.name)}(\s|$)")
        idx = next((i for i, l in enumerate(lines) if pattern.match(l)), None)
        if idx is not None:
            lines[idx] = new
            continue
        header = next((i for i, l in enumerate(lines) if l.strip() == f"# {a.category}"), None)
        if header is None:
            while lines and not lines[-1].strip():
                lines.pop()
            lines += ["", f"# {a.category}", new]
        else:
            end = header + 1
            while end < len(lines) and lines[end].strip() and not lines[end].startswith("#"):
                end += 1
            lines.insert(end, new)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("\n".join(lines).rstrip("\n") + "\n")
    os.replace(tmp, path)
    subprocess.run(["xmonad", "--restart"], check=False)


def save_custom(actions, deleted=None, restart=True):
    """Update actions.conf from the editor's custom actions. Lines the editor
    does not know about (e.g. added by hand since xmonad last restarted) and
    the comment header are kept as they are; deleted names are dropped.
    Writes atomically through the stow symlink."""
    path = os.path.realpath(CUSTOM_FILE) if os.path.exists(CUSTOM_FILE) else CUSTOM_FILE
    clean = lambda t: " ".join(t.split())   # no tabs or newlines inside a field
    mine = {a.name: f"{clean(a.category)}\t{a.name}\t{clean(a.desc)}\t{clean(a.command)}"
            for a in actions if a.custom}
    out, written = [], set()
    if os.path.exists(path):
        with open(path, encoding="utf-8") as f:
            for line in f.read().split("\n"):
                fields = line.split("\t")
                name = fields[1] if len(fields) >= 4 and not line.startswith("#") else None
                if name is None:
                    out.append(line)
                elif name == deleted:
                    continue
                elif name in mine:
                    out.append(mine[name])
                    written.add(name)
                else:
                    out.append(line)
    out += [line for name, line in mine.items() if name not in written]
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("\n".join(out).strip("\n") + "\n")
    os.replace(tmp, path)
    if restart:
        subprocess.run(["xmonad", "--restart"], check=False)


def slug(text):
    s = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return s[:40] or "action"


def new_custom(actions, desc, command, category):
    """Add a custom action and return it."""
    base = "custom-" + slug(desc)
    name, n = base, 2
    while any(a.name == name for a in actions):
        name, n = f"{base}-{n}", n + 1
    a = Action(category or "Custom", name, desc, "", "", "custom", command)
    actions.append(a)
    save_custom(actions)
    return a


def delete_custom(actions, a):
    actions.remove(a)
    a.keys = []
    save(actions, [a])          # leaves "name" alone in keys.conf ...
    path = os.path.realpath(KEYS_FILE)
    with open(path, encoding="utf-8") as f:
        lines = [l for l in f.read().split("\n") if not re.match(rf"^{re.escape(a.name)}(\s|$)", l)]
    # Drop the category header if that section is now empty
    header = f"# {a.category}"
    if header in lines:
        i = lines.index(header)
        rest = lines[i + 1:]
        nxt = next((l for l in rest if l.strip()), None)
        if nxt is None or nxt.startswith("#"):
            del lines[i]
            while i > 0 and i <= len(lines) and not lines[i - 1].strip() and (i == len(lines) or not lines[i].strip()):
                del lines[i - 1]
                i -= 1
    with open(path + ".tmp", "w", encoding="utf-8") as f:
        f.write("\n".join(lines).rstrip("\n") + "\n")
    os.replace(path + ".tmp", path)  # ... so drop the line completely
    save_custom(actions, deleted=a.name)


def describe(a):
    return ", ".join(xkeys.to_pretty(k) for k in a.keys) or "(none)"


# ---------------------------------------------------------------------------
# Operations shared by the CLI and the rofi UI
# ---------------------------------------------------------------------------

def set_key(actions, a, slot, ez, steal=False):
    """Assign ez to slot (1-based). Returns the action that owned it, if any
    and steal is False (nothing changed then)."""
    ez = xkeys.canonical(ez)
    other = owner(actions, ez, skip=a)
    if other and not steal:
        return other
    changed = [a]
    if other:
        other.keys = [k for k in other.keys if xkeys.canonical(k) != ez]
        changed.append(other)
    keys = [k for k in a.keys if xkeys.canonical(k) != ez]
    slot = min(slot, len(keys) + 1)
    if slot <= len(keys):
        keys[slot - 1] = ez
    else:
        keys.append(ez)
    a.keys = keys
    save(actions, changed)
    return None


def remove_key(actions, a, slot):
    if 1 <= slot <= len(a.keys):
        del a.keys[slot - 1]
        save(actions, [a])


def reset_keys(actions, a):
    changed = [a]
    for k in a.default:  # defaults may now belong to another action
        other = owner(actions, k, skip=a)
        if other:
            other.keys = [x for x in other.keys if xkeys.canonical(x) != xkeys.canonical(k)]
            changed.append(other)
    a.keys = list(a.default)
    save(actions, changed)


# ---------------------------------------------------------------------------
# rofi UI
# ---------------------------------------------------------------------------

THEME = ("window { width: 78%; } listview { lines: 18; spacing: 0; } element { padding: 4px 12px; } "
         "element selected.normal { background-color: #313244; text-color: #cdd6f4; }")


SMALL = "window { width: 34%; } listview { lines: 3; }"


def esc(s):
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def rofi(rows, prompt, mesg=None, theme=THEME, custom=False):
    """Show rows (markup) and return the selected index, or None. With
    custom=True, typed text that matches no row is returned as a string."""
    cmd = ["rofi", "-dmenu", "-i", "-markup-rows", "-format", "i:f", "-p", prompt, "-theme-str", theme]
    if not custom:
        cmd.append("-no-custom")
    if mesg:
        cmd += ["-mesg", mesg]
    res = subprocess.run(cmd, input="\n".join(rows), capture_output=True, text=True)
    if res.returncode != 0 or ":" not in res.stdout:
        return None
    index, typed = res.stdout.rstrip("\n").split(":", 1)
    if index == "-1":
        return typed if custom and typed.strip() else None
    return int(index)


def confirm(question):
    return rofi(["No", "Yes"], question, theme=SMALL) == 1


def notify(body):
    subprocess.run(["notify-send", "-a", "osd", "-u", "low", "-t", "3000", "-i", "input-keyboard",
                    "Shortcuts", body], check=False)


def assign(actions, a, slot, ez):
    _, key = xkeys.split(ez)
    special = xkeys.key_name(key).startswith(("F", "XF86", "Print")) and len(xkeys.key_name(key)) > 1
    if "-" not in ez and not special:
        if not confirm(f"{xkeys.to_pretty(ez)} has no modifier: typing it anywhere runs the action. Use it?"):
            return
    other = set_key(actions, a, slot, ez)
    if other:
        if not confirm(f"{xkeys.to_pretty(ez)} is used by “{other.desc}”. Move it here?"):
            return
        set_key(actions, a, slot, ez, steal=True)
    notify(f"{a.desc}: {describe(a)}")


def edit_action(actions, a):
    while True:
        options, rows = [], []
        for i, k in enumerate(a.keys, 1):
            options += [("set", i), ("remove", i)]
            rows += [f"Change shortcut {i}   <span foreground='#fab387'>{esc(xkeys.to_pretty(k))}</span>",
                     f"Remove shortcut {i}"]
        if len(a.keys) < MAX_SLOTS:
            options.append(("set", len(a.keys) + 1))
            rows.append(f"Add a shortcut   <span foreground='#7f849c'>(press it)</span>")
        options.append(("free", len(a.keys) + 1))
        rows.append(f"Pick or type a shortcut   <span foreground='#7f849c'>(e.g. Super+Shift+X)</span>")
        if a.custom:
            options += [("command", 0), ("rename", 0), ("delete", 0)]
            rows += [f"Change the command   <span foreground='#7f849c'>{esc(a.command)}</span>",
                     "Change the description", "Delete this action"]
        if a.keys != a.default:
            options.append(("reset", 0))
            rows.append(f"Reset to default   <span foreground='#7f849c'>"
                        f"{esc(', '.join(xkeys.to_pretty(k) for k in a.default) or '(none)')}</span>")
        sel = rofi(rows, f" {a.desc}", mesg=f"Current: {esc(describe(a))}")
        if sel is None:
            return
        op, slot = options[sel]
        if op == "set":
            ez = xkeys.capture()
            if ez:
                assign(actions, a, slot, ez)
        elif op == "remove":
            remove_key(actions, a, slot)
            notify(f"{a.desc}: {describe(a)}")
        elif op == "free":
            if slot > MAX_SLOTS:  # both slots taken: choose which one to replace
                slot = rofi([f"Replace shortcut {i}   <span foreground='#fab387'>{esc(xkeys.to_pretty(k))}</span>"
                             for i, k in enumerate(a.keys, 1)], " Replace", theme=SMALL)
                if slot is None:
                    continue
                slot += 1
            free = free_shortcuts(actions)
            pick = rofi([esc(xkeys.to_pretty(k)) for k in free], " Shortcut", custom=True,
                        mesg="Pick a free one, or type your own (Super+Shift+X, ctrl+alt+k, M-S-x) and press Enter")
            if isinstance(pick, int):
                assign(actions, a, slot, free[pick])
            elif isinstance(pick, str):
                ez = xkeys.parse_typed(pick)
                if ez:
                    assign(actions, a, slot, ez)
                else:
                    notify(f"Not a valid shortcut: {pick}")
        elif op == "reset":
            reset_keys(actions, a)
            notify(f"{a.desc}: {describe(a)}")
        elif op == "command":
            cmd = rofi([], " Command", custom=True, mesg=f"Current: {esc(a.command)}")
            if isinstance(cmd, str):
                a.command = cmd.strip()
                save_custom(actions)
        elif op == "rename":
            desc = rofi([], " Description", custom=True, mesg=f"Current: {esc(a.desc)}")
            if isinstance(desc, str):
                a.desc = desc.strip()
                save_custom(actions)
        elif op == "delete":
            if confirm(f"Delete \u201c{a.desc}\u201d?"):
                delete_custom(actions, a)
                notify(f"Deleted: {a.desc}")
                return


def ask_new_action(actions):
    desc = rofi([], " New action", custom=True,
                mesg="Describe what it does, e.g. <i>Open Spotify</i>, and press Enter")
    if not isinstance(desc, str):
        return None
    cmd = rofi([], " Command", custom=True,
               mesg=f"Shell command for \u201c{esc(desc.strip())}\u201d, e.g. <i>flatpak run com.spotify.Client</i>")
    if not isinstance(cmd, str):
        return None
    cats = list(dict.fromkeys(["Custom"] + [x.category for x in actions]))
    pick = rofi([esc(c) for c in cats], " Category", custom=True, theme=SMALL.replace("3", "8"),
                mesg="Pick a category or type a new one")
    category = cats[pick] if isinstance(pick, int) else (pick.strip() if isinstance(pick, str) else "Custom")
    a = new_custom(actions, desc.strip(), cmd.strip(), category)
    notify(f"New action: {a.desc}")
    return a


def main_menu():
    actions = load_actions()
    while True:
        rows, last = ["<span foreground='#a6e3a1'><b>+ New action</b></span>   (run a command)"], None
        for a in actions:
            cat = (f"<span foreground='#f5c2e7'><b>{esc(a.category):<14}</b></span>" if a.category != last
                   else f"<span foreground='#45475a'>{esc(a.category):<14}</span>")
            last = a.category
            keys = (f"<span foreground='#fab387'>{esc(describe(a)):<44}</span>" if a.keys
                    else f"<span foreground='#585b70'>{'(none)':<44}</span>")
            mark = " <span foreground='#a6e3a1'>(custom)</span>" if a.custom else ""
            rows.append(f"{cat}  {keys}  {esc(a.desc)}{mark}")
        sel = rofi(rows, " Edit shortcuts", mesg="Pick an action to change its shortcuts (up to two each)")
        if sel is None or isinstance(sel, str):
            return
        if sel == 0:
            a = ask_new_action(actions)
            if a:
                edit_action(actions, a)
            continue
        edit_action(actions, actions[sel - 1])


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def cli(args):
    actions = load_actions()
    cmd = args[0]
    if cmd == "list":
        for a in actions:
            print(f"{a.category:<14} {a.name:<26} {describe(a)}")
    elif cmd == "set" and len(args) == 4:
        a = find(actions, args[1])
        other = set_key(actions, a, int(args[2]), args[3], steal="--force" in sys.argv)
        if other:
            sys.exit(f"keys-editor: {args[3]} is used by '{other.name}' (add --force to move it)")
        print(f"{a.name}: {describe(a)}")
    elif cmd == "remove" and len(args) == 3:
        a = find(actions, args[1])
        remove_key(actions, a, int(args[2]))
        print(f"{a.name}: {describe(a)}")
    elif cmd == "reset" and len(args) == 2:
        a = find(actions, args[1])
        reset_keys(actions, a)
        print(f"{a.name}: {describe(a)}")
    elif cmd == "new" and len(args) >= 3:
        a = new_custom(actions, args[1], args[2], args[3] if len(args) > 3 else "Custom")
        print(a.name)
    elif cmd == "delete" and len(args) == 2:
        a = find(actions, args[1])
        if not a.custom:
            sys.exit(f"keys-editor: '{a.name}' is a built-in action")
        delete_custom(actions, a)
        print(f"deleted {a.name}")
    elif cmd == "edit" and len(args) == 2:
        edit_action(actions, find(actions, args[1]))
    elif cmd == "free":
        print("\n".join(free_shortcuts(actions, int(args[1]) if len(args) > 1 else 12)))
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    argv = [a for a in sys.argv[1:] if a != "--force"]
    cli(argv) if argv else main_menu()
