#!/usr/bin/env python3
"""Mini calendar for the bar (bin/calendar-toggle opens and closes it).

A small month grid in GTK 3 with Catppuccin colours. The week starts on
Sunday. Only today is highlighted (a pink circle); days with Google Calendar
events are bold with a pink dot under them; days of the next and previous
months are grey. The arrows change month and year. The list below shows the
events of today or of the clicked day (calevents reads the iCal addresses in
~/.config/mini-calendar/ics-url and refreshes them in the background).
"Open Google Calendar" or a double click on a day opens it in Brave. Esc
closes the window. xmonad floats it in the bottom-right corner (WM class
calendar-popup).

GtkCalendar is not used because it always keeps a day selected and, with
day details shown, draws a line under every day number.
"""
import calendar
import datetime as dt
import os
import subprocess
import sys
import threading

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib, Gtk, Pango  # noqa: E402

sys.path.insert(0, os.path.expanduser("~/.local/lib/mini-calendar"))
import calevents  # noqa: E402

LIST_HEIGHT = 120
PINK, BASE, TEXT, GREY, DIM = "#f5c2e7", "#1e1e2e", "#cdd6f4", "#7f849c", "#585b70"
CSS = f"""
.mc-day, .mc-nav {{ background: none; border: none; box-shadow: none; padding: 0; }}
.mc-day {{ min-width: 30px; min-height: 34px; border-radius: 8px; color: {TEXT}; }}
.mc-day:hover {{ background: alpha({TEXT}, 0.08); }}
.mc-other {{ color: {DIM}; }}
.mc-today, .mc-today:hover {{ background: {PINK}; color: {BASE}; }}
.mc-weekday {{ color: {GREY}; font-size: smaller; }}
.mc-nav {{ min-width: 22px; min-height: 22px; color: {GREY}; }}
.mc-nav:hover {{ color: {TEXT}; }}
""".encode()


def esc(text):
    return GLib.markup_escape_text(text)


class MiniCalendar(Gtk.Window):
    def __init__(self):
        super().__init__(title="Calendar")
        self.set_wmclass("calendar-popup", "calendar-popup")
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_keep_above(True)
        self.set_resizable(False)
        self.set_border_width(8)
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.add(box)
        box.pack_start(self.build_header(), False, False, 0)
        box.pack_start(self.build_grid(), False, False, 0)
        box.pack_start(Gtk.Separator(), False, False, 2)

        self.heading = Gtk.Label(xalign=0)
        box.pack_start(self.heading, False, False, 0)
        self.events_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_size_request(-1, LIST_HEIGHT)
        scroll.add(self.events_box)
        box.pack_start(scroll, False, False, 0)
        button = Gtk.Button(label="Open Google Calendar")
        button.connect("clicked", lambda _b: self.open_google(self.shown_day))
        box.pack_start(button, False, False, 0)

        today = dt.date.today()
        self.month = (today.year, today.month)
        self.shown_day = today
        self.event_days = set()
        self.connect("key-press-event", self.on_key)
        self.connect("destroy", Gtk.main_quit)
        self.refresh_view()
        # Show the cached events at once and update them in the background
        threading.Thread(target=self.update_feeds, daemon=True).start()

    # --- layout ---------------------------------------------------------------

    def nav_button(self, text, step):
        b = Gtk.Button(label=text)
        b.get_style_context().add_class("mc-nav")
        b.connect("clicked", lambda _b: self.change_month(step))
        return b

    def build_header(self):
        header = Gtk.Box(spacing=2)
        self.month_label = Gtk.Label()
        self.year_label = Gtk.Label()
        header.pack_start(self.nav_button("‹", -1), False, False, 0)
        header.pack_start(self.month_label, False, False, 4)
        header.pack_start(self.nav_button("›", 1), False, False, 0)
        header.pack_end(self.nav_button("›", 12), False, False, 0)
        header.pack_end(self.year_label, False, False, 4)
        header.pack_end(self.nav_button("‹", -12), False, False, 0)
        return header

    def build_grid(self):
        grid = Gtk.Grid(column_homogeneous=True, row_spacing=1, column_spacing=1)
        for col, name in enumerate(["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]):
            label = Gtk.Label(label=name)
            label.get_style_context().add_class("mc-weekday")
            grid.attach(label, col, 0, 1, 1)
        self.cells = []                       # 6 weeks x 7 days, always shown
        for i in range(42):
            label = Gtk.Label()
            cell = Gtk.Button()
            cell.add(label)
            cell.get_style_context().add_class("mc-day")
            cell.connect("button-press-event", self.on_day_press)
            grid.attach(cell, i % 7, 1 + i // 7, 1, 1)
            self.cells.append((cell, label))
        return grid

    # --- behaviour ------------------------------------------------------------

    def change_month(self, step):
        year, month = self.month
        index = year * 12 + (month - 1) + step
        self.month = (index // 12, index % 12 + 1)
        today = dt.date.today()
        self.shown_day = today if self.month == (today.year, today.month) else None
        self.refresh_view()

    def on_day_press(self, cell, event):
        day = cell.day
        if event.type == Gdk.EventType._2BUTTON_PRESS:
            self.open_google(day)
        elif event.button == 1:
            if (day.year, day.month) != self.month:     # a grey day: go to its month
                self.month = (day.year, day.month)
            self.shown_day = day
            self.refresh_view()
        return True

    def on_key(self, _widget, event):
        if event.keyval == Gdk.KEY_Escape:
            self.destroy()

    # --- drawing and events ---------------------------------------------------

    def update_feeds(self):
        if calevents.refresh():
            GLib.idle_add(self.refresh_view)

    def refresh_view(self):
        year, month = self.month
        today = dt.date.today()
        self.month_label.set_markup(f"<b>{calendar.month_name[month]}</b>")
        self.year_label.set_markup(f"<b>{year}</b>")
        self.event_days = calevents.days_with_events(year, month)
        first = dt.date(year, month, 1)
        start = first - dt.timedelta(days=(first.weekday() + 1) % 7)   # back to Sunday
        for i, (cell, label) in enumerate(self.cells):
            day = start + dt.timedelta(days=i)
            cell.day = day
            ctx = cell.get_style_context()
            in_month = day.month == month
            for cls, on in (("mc-other", not in_month), ("mc-today", day == today)):
                (ctx.add_class if on else ctx.remove_class)(cls)
            has_event = in_month and day.day in self.event_days
            number = f"<b>{day.day}</b>" if has_event else str(day.day)
            dot_color = BASE if day == today else PINK
            dot = f"<span foreground='{dot_color}' size='x-small'>●</span>" if has_event else \
                  "<span size='x-small'> </span>"
            label.set_markup(f"{number}\n{dot}")
            label.set_justify(Gtk.Justification.CENTER)
        self.refresh_list()
        return False

    def refresh_list(self):
        for child in self.events_box.get_children():
            self.events_box.remove(child)
        if not calevents.sources():
            self.heading.set_markup(f"<span foreground='{GREY}'>No calendars yet</span>")
            self.add_line(f"<span foreground='{GREY}'>Add your Google Calendar iCal\n"
                          f"address to ~/.config/mini-calendar/ics-url</span>")
        elif self.shown_day is None:
            self.heading.set_markup(f"<span foreground='{GREY}'>Pick a day to see its events</span>")
        else:
            label = "Today" if self.shown_day == dt.date.today() else self.shown_day.strftime("%a %-d %b")
            self.heading.set_markup(f"<b>{esc(label)}</b>")
            events = calevents.events_between(self.shown_day, self.shown_day)
            if not events:
                self.add_line(f"<span foreground='{GREY}'>No events</span>")
            for ev in events:
                when = "All day" if ev.all_day else ev.start.strftime("%H:%M")
                self.add_line(f"<span foreground='{ev.color}'>●</span> "
                              f"<span foreground='{GREY}'>{when}</span>  {esc(ev.summary)}")
        self.events_box.show_all()

    def add_line(self, markup):
        label = Gtk.Label(xalign=0)
        label.set_markup(markup)
        label.set_ellipsize(Pango.EllipsizeMode.END)
        label.set_max_width_chars(28)
        self.events_box.pack_start(label, False, False, 0)

    def open_google(self, day):
        day = day or dt.date(*self.month, 1)
        url = f"https://calendar.google.com/calendar/r/day/{day.year}/{day.month}/{day.day}"
        subprocess.Popen(["brave-browser", f"--app={url}"], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.destroy()


if __name__ == "__main__":
    MiniCalendar().show_all()
    Gtk.main()
