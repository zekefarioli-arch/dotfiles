#!/usr/bin/env bash
# Google Calendar as its own app, with the Claude browser extension.
#
# What it is: a Brave profile used only for the calendar
# (~/.local/share/calendar-app). It runs as a separate browser process with
# its own window class (CalendarApp), its own extensions, its own Google login
# and its own theme, and it opens fullscreen, where Brave hides its tab strip
# and address bar. The launcher is xdg/.local/share/applications/
# google-calendar.desktop (shown in rofi), and Super+Shift+C runs it.
#
# Why not a real app window (brave --app=URL, or tools such as Web App Hub,
# which do the same): app windows have no side panel, and the Claude extension
# also needs normal windows for its tab groups, so it cannot work there.
#
# First run (Super+Ctrl+C opens all of it):
#   1. accept Brave's welcome screen;
#   2. install Claude and the Catppuccin Mocha theme from the Chrome Web Store;
#   3. sign in to Google and to the Claude extension;
#   4. in Google Calendar: Settings > Appearance > Dark.
# Then Ctrl+E opens and closes Claude next to the calendar (if not, set the
# shortcut in brave://extensions/shortcuts inside this profile).
#
# Usage: google-calendar [YYYY-MM-DD]   open the calendar (on that day)
#        google-calendar extensions     extensions page plus Claude and theme
set -u

profile="${XDG_DATA_HOME:-$HOME/.local/share}/calendar-app"
url=https://calendar.google.com/calendar/r
store=https://chromewebstore.google.com/detail
claude="$store/fcoeoabgfenejglbffodgkkbkcdhcgfn"   # Claude (Anthropic)
theme="$store/bkkmolkhemgaeaeggcmfbghljjjoofoh"    # Catppuccin Chrome Theme - Mocha

brave() {
  # --force-dark-mode: dark browser UI (menus, dialogs, side panel frame)
  setsid -f brave-browser --user-data-dir="$profile" --class=CalendarApp \
    --no-first-run --no-default-browser-check --force-dark-mode "$@" >/dev/null 2>&1
}

case "${1:-}" in
  extensions)
    brave --new-window brave://extensions "$claude" "$theme"
    ;;
  *)
    if [[ ${1:-} =~ ^([0-9]{4})-0?([0-9]{1,2})-0?([0-9]{1,2})$ ]]; then
      url+="/day/${BASH_REMATCH[1]}/${BASH_REMATCH[2]}/${BASH_REMATCH[3]}"
    fi
    # --start-fullscreen only applies when the profile is not running yet; if
    # it is, the new window is made fullscreen through the window manager
    # (EWMH state, not simulated keys)
    before=" $(xdotool search --onlyvisible --class CalendarApp 2>/dev/null | tr '\n' ' ') "
    # Through Google's login: without a session calendar.google.com shows the
    # Workspace product page; with one, ServiceLogin goes straight to $url
    login="https://accounts.google.com/ServiceLogin?service=cl&continue=$(
      python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$url")"
    brave --start-fullscreen --new-window "$login"
    [[ $before == "  " ]] && exit 0
    for _ in $(seq 40); do
      sleep 0.25
      for w in $(xdotool search --onlyvisible --class CalendarApp 2>/dev/null); do
        [[ $before == *" $w "* ]] && continue
        sleep 0.5
        xdotool windowstate --add FULLSCREEN "$w"
        exit 0
      done
    done
    ;;
esac
