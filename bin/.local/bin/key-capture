#!/usr/bin/env python3
"""Capture a key combination and print it as JSON (xmonad, readable and
xdotool forms). Exits with status 1 if cancelled (Esc) or timed out.
Usage: key-capture [--timeout SECONDS] [--quiet]"""
import argparse
import json
import os
import sys

sys.path.insert(0, os.path.expanduser("~/.local/lib/xmonad-keys"))
import xkeys  # noqa: E402

parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
parser.add_argument("--timeout", type=float, default=10.0)
parser.add_argument("--quiet", action="store_true", help="no notifications")
args = parser.parse_args()

ez = xkeys.capture(timeout=args.timeout, notify=not args.quiet)
if not ez:
    sys.exit(1)
print(json.dumps({"ez": ez, "pretty": xkeys.to_pretty(ez), "xdotool": xkeys.to_xdotool(ez)}))
