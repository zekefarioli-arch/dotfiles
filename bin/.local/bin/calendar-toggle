#!/usr/bin/env bash
# Toggle the mini calendar (bin/mini-calendar, GTK 3, Catppuccin theme). xmonad
# places it in the bottom-right corner of the screen, just above the bar
# (class calendar-popup, see bottomRightCorner in xmonad.hs).
# Weeks start on Sunday; the arrows change month and year, only today is
# highlighted and days with Google Calendar events get a dot. Another click on the date closes it (not losing the
# focus: xmonad focuses whatever window the mouse moves over).
# Polybar runs it on a click on the date.
PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/calendar-toggle.pid"

if [[ -r $PIDFILE ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
  kill "$(cat "$PIDFILE")"; rm -f "$PIDFILE"; exit 0
fi

setsid ~/.local/bin/mini-calendar >/dev/null 2>&1 &
echo $! > "$PIDFILE"
