#!/usr/bin/env bash
# Toggle a small calendar (yad, GTK, so it follows the Catppuccin theme). xmonad
# places it in the bottom-right corner of the screen, just above the bar
# (class calendar-popup, see bottomRightCorner in xmonad.hs).
# Weeks start on Sunday (US date conventions only for this window); the arrows
# change month and year. It also closes when it loses the focus.
# Polybar runs it on a click on the date.
PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/calendar-toggle.pid"

if [[ -r $PIDFILE ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
  kill "$(cat "$PIDFILE")"; rm -f "$PIDFILE"; exit 0
fi

LC_TIME=en_US.UTF-8 setsid yad --calendar --class=calendar-popup --title=Calendar \
  --undecorated --no-buttons --skip-taskbar --on-top --close-on-unfocus --fixed \
  >/dev/null 2>&1 &
echo $! > "$PIDFILE"
