# Let the video group change the screen brightness (Fedora ships this with brightnessctl, Ubuntu does not)
# Install on Ubuntu: sudo cp this to /etc/udev/rules.d/, then sudo usermod -aG video zeke, and log in again.
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/bin/chgrp video /sys/class/backlight/%k/brightness", RUN+="/bin/chmod g+w /sys/class/backlight/%k/brightness"
ACTION=="add", SUBSYSTEM=="leds", RUN+="/bin/chgrp input /sys/class/leds/%k/brightness", RUN+="/bin/chmod g+w /sys/class/leds/%k/brightness"
