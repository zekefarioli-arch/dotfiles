#!/bin/bash
# Automatic timezone: when a network connects, look up the location by IP
# with Fedora's geoip service (the same one the installer uses) and switch
# the timezone if it changed (e.g. when travelling to another country).
# Note: with a VPN up, the VPN server's location is used.
# Install: sudo install -m 755 this-file /etc/NetworkManager/dispatcher.d/
#           sudo restorecon -v /etc/NetworkManager/dispatcher.d/90-auto-timezone
case "$2" in
  up|connectivity-change) ;;
  *) exit 0 ;;
esac

tz=$(curl -fsS --max-time 8 https://geoip.fedoraproject.org/city |
     python3 -c 'import sys, json; print(json.load(sys.stdin).get("time_zone") or "")' 2>/dev/null)

[[ -n $tz && -e /usr/share/zoneinfo/$tz ]] || exit 0
current=$(timedatectl show -p Timezone --value)
if [[ $current != "$tz" ]]; then
  timedatectl set-timezone "$tz"
  logger -t auto-timezone "timezone: $current -> $tz"
fi
