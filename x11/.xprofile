# ~/.xprofile — lo carga LightDM (y autostart.sh) al iniciar la sesión X

# Qt: qt6ct + Kvantum (Catppuccin Mocha Pink); QT_STYLE_OVERRIDE cubre apps Qt5
export QT_QPA_PLATFORMTHEME=qt6ct
export QT_STYLE_OVERRIDE=kvantum

# Cursor Catppuccin también para apps que no leen la config de GTK
export XCURSOR_THEME=catppuccin-mocha-pink-cursors
export XCURSOR_SIZE=24
[ -f ~/.Xresources ] && xrdb -merge ~/.Xresources
