# ~/.xprofile — loaded by LightDM (and autostart.sh) when the X session starts

# Qt: qt6ct + Kvantum (Catppuccin Mocha Pink); QT_STYLE_OVERRIDE covers Qt5 apps
export QT_QPA_PLATFORMTHEME=qt6ct
export QT_STYLE_OVERRIDE=kvantum

# Catppuccin cursor also for apps that do not read the GTK settings
export XCURSOR_THEME=catppuccin-mocha-pink-cursors
export XCURSOR_SIZE=24
[ -f ~/.Xresources ] && xrdb -merge ~/.Xresources
